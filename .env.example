# ============================================================
# KG-MAG — Knowledge-Grounded Medium Article Generator
# Copy this file to .env and fill in your keys.
# NEVER commit .env to version control.
# ============================================================

# --- LLM Provider (Anthropic Claude) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Image Generation (Nanobananpro) ---
NANOBANANPRO_API_KEY=your_nanobananpro_api_key_here
NANOBANANPRO_API_URL=https://api.nanobananpro.com/v1/generate

# --- Vector Database ---
# Options: "faiss" | "chroma"
VECTOR_DB=faiss
CHROMA_HOST=localhost
CHROMA_PORT=8001

# --- Embedding Model ---
# Runs locally — no API key required
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu   # "cuda" if GPU available

# --- FastAPI Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,https://your-vercel-app.vercel.app

# --- Storage ---
KNOWLEDGE_BASE_PATH=./data/kb
UPLOADS_PATH=./data/uploads
ARTIFACTS_PATH=./data/artifacts
FAISS_INDEX_PATH=./data/kb/faiss_index

# --- Pipeline Tuning ---
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RETRIEVAL=8
RERANK_TOP_K=4
MAX_ARTICLE_TOKENS=4096
QA_GROUNDING_THRESHOLD=0.65
QA_READABILITY_MIN=50.0   # Flesch Reading Ease

# --- Auth (optional — set to enable API key auth on endpoints) ---
BACKEND_API_KEY=change_me_in_production

# --- Environment ---
ENVIRONMENT=development   # "production" for Vercel/Docker
LOG_LEVEL=INFO
