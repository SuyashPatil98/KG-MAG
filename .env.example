# ============================================================
# KG-MAG — Knowledge-Grounded Medium Article Generator
# Copy this file to .env and fill in your keys.
# NEVER commit .env to version control.
# ============================================================

# --- LLM Provider (OpenAI) ---
OPENAI_API_KEY=your_openai_api_key_here

# --- Image Generation (Nanobananpro) ---
NANOBANANPRO_API_KEY=your_nanobananpro_api_key_here
NANOBANANPRO_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-3-pro-image-preview:generateContent

# --- Vector Database ---
# Options: "faiss" | "chroma"
VECTOR_DB=faiss
CHROMA_HOST=localhost
CHROMA_PORT=8001

# --- Embedding Model ---
# Runs locally — no API key required
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu   # "cuda" if GPU available

# --- FastAPI Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,https://your-vercel-app.vercel.app
BACKEND_API_KEY=replace_with_a_long_random_secret

# --- Frontend server-side proxy (Next.js runtime) ---
# Use backend internal DNS/URL where your frontend server can reach the API.
BACKEND_INTERNAL_URL=http://backend:8000

# --- Storage ---
KNOWLEDGE_BASE_PATH=./data/kb
UPLOADS_PATH=./data/uploads
ARTIFACTS_PATH=./data/artifacts
FAISS_INDEX_PATH=./data/kb/faiss_index

# --- Pipeline Tuning ---
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RETRIEVAL=8
RERANK_TOP_K=4
MAX_ARTICLE_TOKENS=4096
PLANNER_MAX_TOKENS=320
WRITER_SOURCE_WORD_BUDGET=900
WRITER_MAX_SOURCES_PER_SECTION=3
WRITER_SECTION_MAX_TOKENS=560
WRITER_CONCLUSION_MAX_TOKENS=280
QA_GROUNDING_THRESHOLD=0.65
QA_READABILITY_MIN=50.0   # Flesch Reading Ease
QA_GROUNDING_MODE=heuristic   # "heuristic" minimizes token use, "llm" is stricter but expensive
QA_PARAGRAPH_CHECKS_PER_SECTION=2
MAX_UPLOAD_FILES_PER_REQUEST=10
MAX_UPLOAD_FILE_SIZE_MB=20
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_GENERATE_REQUESTS=6
RATE_LIMIT_INGEST_REQUESTS=8
RATE_LIMIT_MANAGEMENT_REQUESTS=30

# --- Environment ---
ENVIRONMENT=development   # "production" for Vercel/Docker
LOG_LEVEL=INFO
